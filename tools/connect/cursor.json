{
  "client": "cursor",
  "describe_cmd": "talaria describe --json",
  "config_file": "~/.cursor/mcp.json",
  "note": "Generate a machine-specific fragment with: talaria connect --client cursor --json",
  "mcpServers_fragment_template": {
    "talaria": {
      "command": "python",
      "args": ["-m", "talaria_cli.mcp_server", "--vault", "${TALARIA_VAULT}"],
      "env": {
        "TALARIA_VAULT": "${TALARIA_VAULT}",
        "PYTHONPATH": "${TALARIA_VAULT}/src"
      }
    }
  },
  "instructions": [
    "Clone/install Talaria; set TALARIA_VAULT to the repo root",
    "Run: talaria connect --client cursor --json",
    "Merge mcpServers_fragment into ~/.cursor/mcp.json",
    "Reload Cursor MCP settings",
    "Call talaria_describe then talaria_status"
  ]
}
